// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Records every detected EMA55/200 and MACD/signal crossover, persisted
/// on each /api/analysis refresh so the dashboard can render a history
/// timeline per symbol. Only NEW crosses are inserted (dedup by
/// symbol + type + detectedAt bucket).
model CrossEvent {
  id         String   @id @default(cuid())
  /// Uppercase symbol, e.g. "BTCUSDT".
  symbol     String
  /// "ema" for EMA55/200 crosses, "macd" for MACD/signal crosses,
  /// "momentum" for histogram sign flips.
  type       String
  /// "bullish" or "bearish".
  direction  String
  /// Price at the moment of detection.
  price      Float
  /// Candle index (from the latest) at which the cross was detected.
  candlesAgo Int
  /// Epoch ms when the backend detected the cross.
  detectedAt DateTime @default(now())

  @@index([symbol, type, detectedAt])
  @@index([detectedAt])
}

/// Paper-trading bot config — a single row (id "default"). No real orders
/// are ever placed; this only drives the simulated BotTrade lifecycle.
model BotConfig {
  id                 String    @id @default("default")
  symbol             String    @default("BTCUSDT")
  initialCapital     Float     @default(1000)
  /// Realized equity — only updated when a BotTrade closes (mirrors
  /// runBacktest's equity accounting in src/lib/backtest.ts).
  equity             Float     @default(1000)
  minConfidence      Int       @default(60)
  stopLossPct        Float     @default(5)
  takeProfitPct      Float     @default(10)
  maxHoldTicks       Int       @default(20)
  positionSizing     String    @default("full")
  fixedFractionalPct Float     @default(25)
  feeBps             Int       @default(10)
  isActive           Boolean   @default(true)
  lastTickAt         DateTime?
  updatedAt          DateTime  @updatedAt
}

/// One simulated trade opened/closed by the bot engine (src/lib/bot/engine.ts).
model BotTrade {
  id              String    @id @default(cuid())
  symbol          String
  /// "BUY" or "SHORT".
  action          String
  /// "OPEN" or "CLOSED".
  status          String
  entryPrice      Float
  entryTime       DateTime
  /// BotConfig.equity snapshot at entry — the basis for position sizing.
  entryEquity     Float
  positionSizePct Float
  confidence      Int
  /// Consensus level at entry, e.g. "strong_buy".
  decisionLabel   String
  ticksOpen       Int       @default(0)
  exitPrice       Float?
  exitTime        DateTime?
  /// "stop_loss" | "take_profit" | "max_hold" | "signal_exit".
  exitReason      String?
  pnl             Float?
  pnlPct          Float?
  feesPaid        Float?

  @@index([status])
  @@index([symbol, entryTime])
}
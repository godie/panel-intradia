# Environment template — copy to `.env` and adjust as needed.
# The dashboard runs out-of-the-box with the defaults below.

# SQLite database file location. In Docker, this lives inside the `app`
# container at /app/db/custom.db (mapped to a named volume).
DATABASE_URL=file:./db/custom.db

# Comma-separated exact browser origins allowed to connect to the Socket.IO
# mini-services. For a custom deployment, include the dashboard's origin.
CORS_ORIGINS=http://localhost:81,http://localhost:8000

# Binance REST base URL. Defaults to https://api.binance.com/api/v3.
# api.binance.com answers HTTP 451 to US IPs, so a host in a US region
# (Railway's default, for example) must point this at the US endpoint:
# BINANCE_BASE_URL=https://api.binance.us/api/v3
